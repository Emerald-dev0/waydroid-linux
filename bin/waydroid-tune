#!/usr/bin/env bash
# Host tuning for faster Waydroid cold boot. Requires root (run with sudo).
#
#   sudo waydroid-tune performance   # pin CPU to max speed (faster boot, more power/heat)
#   sudo waydroid-tune schedutil     # restore the default on-demand governor
#   sudo waydroid-tune status        # show the current governor
#
# The CPU governor is the main host-side lever: the emulator's cold boot is
# CPU-bound on this machine, and the default "schedutil" governor ramps
# frequency slowly. "performance" keeps the cores at top speed during boot.
set -e
if [ "$(id -u)" -ne 0 ]; then
    echo "must run as root:  sudo $0 $*" >&2
    exit 1
fi

gov="${1:-status}"
case "$gov" in
    status)
        printf "current governor: "
        cat /sys/devices/system/cpu/cpu0/cpufreq/scaling_governor
        ;;
    performance|schedutil|powersave|ondemand|conservative|userspace)
        for f in /sys/devices/system/cpu/cpu*/cpufreq/scaling_governor; do
            echo "$gov" >"$f" 2>/dev/null || true
        done
        echo "CPU governor -> $gov"
        ;;
    *)
        echo "usage: sudo $0 [performance|schedutil|status]" >&2
        exit 1
        ;;
esac